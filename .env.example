# Backend settings (server-side only)
B_BACKEND=sqlite
B_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
B_SQLITE_DB_PATH=AppData/db.sqlite
B_SESSION_LIFETIME_DAYS=7
B_DB_POOL_MIN_SIZE=2
B_DB_POOL_MAX_SIZE=15
B_DB_POOL_TIMEOUT_SECONDS=10
B_DB_POOL_MAX_WAITING=20
B_AUTO_MIGRATE=true
B_SLOW_REQUEST_LOG_MS=750

# Supabase PostgreSQL; use the database URI, not an API URL or API key.
# B_SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# B_SUPABASE_DB_PASS=<database-password>

# Neon PostgreSQL; copy the connection URI from the Neon console.
# B_NEON_DB_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# B_NEON_DB_PASS=<database-password>

# Frontend settings (only these F_ values are read by Vite)
F_APP_NAME=DotMuted
F_BACKEND_URL=http://127.0.0.1:8000
F_BASE_PATH=/