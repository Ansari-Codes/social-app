{
  "name": "silence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
      "test": "npm run test:sqliteback && npm run test:supaback && npm run test:neonback",
      "test:sqliteback": "python -m unittest discover -s backend/sqliteback/tests -p \"test_*.py\"",
      "test:supaback": "python -m unittest discover -s backend/supaback/tests -p \"test_*.py\"",
      "test:neonback": "python -m unittest discover -s backend/neonback/tests -p \"test_*.py\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^18.0.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
